# Buffer API & CLI Credentials
# Obtain your API token from: https://publish.buffer.com/settings/api
BUFFER_API_KEY=buf_live_your_api_token_here

# Default Target Organization ID (optional, fetched automatically if empty)
BUFFER_ORGANIZATION_ID=

# Default Target Channel ID for LinkedIn (optional, fetched via `content-ops channels`)
BUFFER_LINKEDIN_CHANNEL_ID=

# GitHub API Token (optional if using `gh` CLI)
GITHUB_TOKEN=

# LLM API configuration (optional for external generation, defaults to deterministic rule-engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution mode: dry-run | draft | queued
BUFFER_POST_MODE=draft
